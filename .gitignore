# --- Rust / Cargo ---
# Любой target/: корневой workspace и crates/kmdf (отдельный [workspace]).
target/
**/*.rs.bk
*.orig

# --- Локальные артефакты verify / bench / demo ---
artifacts/

# --- Windows / KMDF / MSVC (сборочные артефакты) ---
*.pdb
*.ilk
*.exp
*.obj
*.lib
*.sys
!driver/*.sys
*.cat
*.cer

# INF — исходники драйвера; не игнорируем.
# Подписанные пакеты кладите в /artifacts/ или /driver/.

# --- IDE ---
.vscode/
.idea/
*.swp
*~

# --- ОС ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Секреты и локальная конфигурация ---
.env
.env.*
!.env.example

# --- Прочее ---
*.log
*.tmp
