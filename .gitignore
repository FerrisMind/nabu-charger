# --- Rust / Cargo ---
# Any target/: the root workspace and crates/*/ (separate [workspace]).
target/
**/target/
**/*.rs.bk
*.orig
*.rlib

# --- Local artifacts of verify / bench / demo / driver packages ---
artifacts/
**/artifacts/

# --- Windows / KMDF / MSVC (build artifacts) ---
*.pdb
*.ilk
*.exp
*.obj
*.lib
*.sys
!driver/*.sys
*.cat
*.cer
*.map
*.iobj
*.ipdb

# INF - driver sources (*.inx / tracked *.inf); we do not ignore them.
# Put signed packages in artifacts/ or driver/.

# --- IDE / editors ---
.vscode/
.idea/
.vs/
*.swp
*~
*.suo
*.user
*.userosscache

# --- Agents / local working directories ---
.swarm/
.cursor/
.codex/

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store
# Stray files from a redirect to NUL on Windows
NUL
nul
CON
con

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12

# --- Misc ---
*.log
*.tmp
*.bak
*.cache
