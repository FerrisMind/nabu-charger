; =====================================================================
; ln8000-kmdf: LN8000 charge pump driver (Xiaomi Pad 5, nabu)
;
; Source:   ln8000_kmdf.inx -> ln8000_kmdf.inf
; Device:   ACPI\QCOM057E (PEIC, I2C 0x51 on \_SB.I2C5)
; Platform: Windows on ARM64 (aarch64-pc-windows-msvc)
;
; The PEIC node already exists in the tablet DSDT (_HID = QCOM057E,
; _STA = 0x0F), so no ACPI changes are needed.
;
; ASCII ONLY. INF string values are read by setupapi as ANSI, so any
; non-ASCII character (Cyrillic, em dash) turns into mojibake in Device
; Manager. Russian explanations live in docs/, not in the INF.
; =====================================================================

[Version]
Signature   = "$WINDOWS NT$"
; Charge pump is NOT a battery device. Class=Battery made Windows treat
; PEIC as a second battery that never implements BATTERY_* IOCTLs, so
; Settings / Win32_Battery disappear (qcbattminiclass alone is not enough).
; Match stock qcpmicEIC: System class.
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
PnpLockDown = 1
; This value is a fallback and a record of the release; the build always stamps
; STAMPINF_VERSION over it (deploy/build-arm64.ps1), because cargo-wdk passes
; stampinf -v * otherwise and a wall-clock stamp can land below what the tablet
; already has. It must stay ABOVE every ln8000_kmdf package already in the
; tablet's DriverStore - a lower DriverVer is refused as "Outranked". The query
; that lists them is in docs/RELEASE.md ("the Outranked trap").
DriverVer   = 09/24/2026,20.47.10.674

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
ln8000_kmdf.sys = 1,,

; ================= device installation =================

[Manufacturer]
%StdMfg% = Ln8000,NT$ARCH$.10.0...16299

[Ln8000.NT$ARCH$.10.0...16299]
%Ln8000.DeviceDesc% = Ln8000_Device, ACPI\QCOM057E
%Ln8000.DeviceDesc% = Ln8000_Device, ACPI\QCOM057E_PEIC

[Ln8000_Device.NT$ARCH$]
CopyFiles = Drivers_Dir

[Drivers_Dir]
ln8000_kmdf.sys

; ================= service installation =================

[Ln8000_Device.NT$ARCH$.Services]
AddService = ln8000_kmdf, %SPSVCINST_ASSOCSERVICE%, Ln8000_Service_Inst

[Ln8000_Service_Inst]
DisplayName    = %Ln8000.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\ln8000_kmdf.sys

; ================= access policy and parameters (profiles) =================
; The device node's own descriptor. The driver applies the same policy in code
; (src/sddl.rs), which covers the symbolic link \\.\nabu_ln8000; this value
; covers the node, whose object is created by the ACPI bus driver and therefore
; does not carry the driver's descriptor. The device interface resolves to that
; object, so both are needed. GENERIC_ALL to LocalSystem and Administrators.
;
; The parameters below are defaults only; override them in the registry without
; rebuilding the driver (see docs/DEPLOY-LN8000.md, "profiles").

[Ln8000_Device.NT$ARCH$.HW]
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"
HKR, Parameters, IinLimitUa,      %REG_DWORD%, 2000000
; FFC fv-max (qcom,fv-max-uv, dtbo-03) = 4.47 V; non-FFC (qcom,non-fcc-fv-max-uv)
; = 4.45 V is the guard taper threshold. 4.42 V is only the QC3 loop limit.
HKR, Parameters, VbatFloatUv,     %REG_DWORD%, 4470000
HKR, Parameters, VacOvpUv,        %REG_DWORD%, 13000000
; protection thresholds (tenths of degC) and currents (uA):
; Thresholds must sit above the crystal idle temperature of this board: live
; measurement on 19.09 at .657 - 43.5-46.1 degC idle (pump in standby) and
; 50.8 degC under 2:1 load. The previous 430/480/550 were below idle, fold-back
; tripped continuously, and the return (threshold minus 3.0 degC hysteresis)
; was unreachable: the input current limit fell to IinFloorUa and stayed there
; forever (live IIN_CTRL = 10, that is 500 mA, with a 2.7 A profile).
HKR, Parameters, TempReduceDc,    %REG_DWORD%, 550
HKR, Parameters, TempBypassDc,    %REG_DWORD%, 600
HKR, Parameters, TempStopDc,      %REG_DWORD%, 650
HKR, Parameters, IinMaxUa,        %REG_DWORD%, 3500000
HKR, Parameters, IinTargetUa,     %REG_DWORD%, 2000000
HKR, Parameters, IinFloorUa,      %REG_DWORD%, 500000
HKR, Parameters, VbatReduceUv,    %REG_DWORD%, 4450000
HKR, Parameters, TelemetryMs,     %REG_DWORD%, 250
HKR, Parameters, BusRetryCount,   %REG_DWORD%, 2
HKR, Parameters, NtcAlarmCfg,     %REG_DWORD%, 226
HKR, Parameters, WatchdogEnabled, %REG_DWORD%, 0
; 0 = pump protections as in the tablet Device Tree, 1 = loops enabled.
; Under Windows the pump itself, not SMB5, drives the battery: with 0 (as in the
; DTS) only the hardware VBAT_OV ~ V_FLOAT*1.02 limits the voltage, and a clean
; installation silently lost the V_FLOAT/IIN loops. That is why the default is 1.
HKR, Parameters, ProtectionProfile, %REG_DWORD%, 1

; ================= strings =================

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
REG_DWORD              = 0x00010001
ProviderString         = "nabu-fastcharge"
StdMfg                 = "(Standard system devices)"
DiskId1                = "ln8000-kmdf installation disk #1"
Ln8000.DeviceDesc      = "Charge pump LN8000 (PEIC) - Xiaomi Pad 5"
Ln8000.SVCDESC         = "ln8000_kmdf - LN8000 charge pump driver"
