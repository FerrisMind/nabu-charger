; =====================================================================
; nabu-charger - Xiaomi Pad 5 charging driver (nabu)
;
; Module: kmdf.inx -> kmdf.inf (template from which cargo-wdk builds the INF)
; Target platform: Windows on ARM64 (aarch64-pc-windows-msvc)
; =====================================================================

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
PnpLockDown = 1
DriverVer   = 09/16/2026,0.1.0.0

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
kmdf.sys = 1,,

; ================= Device installation =================
; The [ClassInstall32] section is NOT needed here: the System class is declared
; by Microsoft, and infverif forbids redefining it (ERROR 1285).

[Manufacturer]
%StdMfg% = NabuCharger,NT$ARCH$.10.0...16299

[NabuCharger.NT$ARCH$.10.0...16299]
%NabuCharger.DeviceDesc% = NabuCharger_Device, root\nabu_charger

[NabuCharger_Device.NT$ARCH$]
CopyFiles = Drivers_Dir

[Drivers_Dir]
kmdf.sys

; ================= Service installation =================

[NabuCharger_Device.NT$ARCH$.Services]
AddService = kmdf, %SPSVCINST_ASSOCSERVICE%, NabuCharger_Service_Inst

[NabuCharger_Service_Inst]
DisplayName    = %NabuCharger.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\kmdf.sys

; ================= Device removal (rollback) =================

[NabuCharger_Device.NT$ARCH$.HW]
; No device settings are required: the parameters come from the logic core.

; ================= Strings =================

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderString         = "nabu-fastcharge"
StdMfg                 = "(Standard system devices)"
DiskId1                = "nabu-charger, installation disk #1"
NabuCharger.DeviceDesc = "nabu-charger - Xiaomi Pad 5 charging controller"
NabuCharger.SVCDESC    = "nabu-charger - charging controller service"
